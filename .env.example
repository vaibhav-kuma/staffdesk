# Copy to .env. Values below are deliberately NOT usable defaults.
DB_USER=staffdesk
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_48
BOOTSTRAP_ADMIN_EMAIL=admin@your-company.example
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_20_PLUS_CHARACTER_PASSPHRASE
API_DOCS_ENABLED=true
# Desktop only. Never copy JWT_SECRET or DB credentials into a desktop installation.
STAFFDESK_API_URL=https://127.0.0.1:8080
STAFFDESK_ALLOW_LOCAL_HTTP=true
